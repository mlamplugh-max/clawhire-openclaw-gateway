# ClawHire OpenClaw Gateway Worker — configuration template.
# Copy to .env for LOCAL dev only. In production these live in FLY SECRETS.
# NEVER commit real values. .env is gitignored.

# --- Server ---
PORT=8000
LOG_LEVEL=info

# --- Auth (fresh DEDICATED worker key; NOT any existing ClawHire prod key) ---
# Generate with: openssl rand -hex 32   then: fly secrets set OPENCLAW_API_KEY=...
OPENCLAW_API_KEY=

# --- Runtime engine ---
# openclaw = real bundled OpenClaw runtime (production). stub = deterministic local engine for contract tests/CI.
OPENCLAW_ENGINE=stub
OPENCLAW_BIN=openclaw
OPENCLAW_HOME=/data/openclaw

# --- Tenancy model (LOCKED: pooled now; dedicated is a later-tier knob) ---
WORKER_TENANCY_MODE=pooled

# --- Per-agent sandbox state root (mounted Fly volume in prod) ---
DATA_ROOT=/data/agents

# --- Tenant OAuth token broker (tool parity) ---
# Worker calls back to ClawHire's secure store to fetch SHORT-LIVED per-tenant OAuth tokens per session.
# Tokens are injected into ONLY that agent's sandbox env, never logged, never persisted, never cross-tenant.
TENANT_TOKEN_BROKER_URL=
# Signed key the worker presents to the broker (Fly secret). NOT a tenant secret.
TENANT_TOKEN_BROKER_KEY=
TENANT_TOKEN_TTL_SECONDS=600

# --- Cost guardrails ($300/mo starting cap) ---
MONTHLY_COST_CAP_USD=300
# Rough Fly machine cost model (shared-cpu-1x ~ $0.0000008/s vCPU + RAM). Tune to your plan.
FLY_MACHINE_USD_PER_SECOND=0.0000022
# Blended LLM $/1K tokens used for spend estimation when the engine doesn't report cost.
LLM_USD_PER_1K_TOKENS=0.0025
# When projected monthly spend exceeds the cap, refuse new sessions (bridge falls back to in-process).
COST_CAP_ENFORCE=true
